# AI-WorkHub Backend Environment Variables
# Copy to .env and configure for your setup

# ============================================
# LLM Provider Selection
# ============================================
# Options: openai | together | ollama | custom
LLM_PROVIDER=ollama

# ============================================
# OpenAI Configuration
# ============================================
# Required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# Together.ai Configuration
# ============================================
# Required when LLM_PROVIDER=together
# TOGETHER_API_KEY=your-together-api-key
TOGETHER_CHAT_MODEL=meta-llama/Llama-3-8b-chat-hf
TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval

# ============================================
# Ollama Configuration (local models)
# ============================================
# Used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ============================================
# Custom OpenAI-Compatible API
# ============================================
# Used when LLM_PROVIDER=custom
# LLM_API_URL=https://your-api.com/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=your-model
# LLM_EMBEDDING_MODEL=your-embedding-model

# ============================================
# Shared LLM Options
# ============================================
# Comma-separated stop words for conversation control
# LLM_STOP_WORDS=HALT,STOP

# ============================================
# Server Configuration
# ============================================
PORT=3001
